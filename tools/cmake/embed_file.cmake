cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED IN_FILE OR NOT DEFINED OUT_FILE)
    message(FATAL_ERROR "IN_FILE and OUT_FILE must be defined")
endif()

# Strip any surrounding quotes if passed via command line
string(REGEX REPLACE "^[\"']|[\"']$" "" IN_FILE "${IN_FILE}")
string(REGEX REPLACE "^[\"']|[\"']$" "" OUT_FILE "${OUT_FILE}")

if(NOT EXISTS "${IN_FILE}")
    message(FATAL_ERROR "Input file does not exist: ${IN_FILE}")
endif()

if(NOT DEFINED VAR_NAME OR VAR_NAME STREQUAL "")
    set(VAR_NAME "kEmbeddedOstLoader")
else()
    string(REGEX REPLACE "^[\"']|[\"']$" "" VAR_NAME "${VAR_NAME}")
endif()

set(READ_TARGET "${IN_FILE}")
set(CLEANUP_TEMP OFF)

if(COMPRESS)
    set(TEMP_GZ "${OUT_FILE}.tmp.gz")
    execute_process(
        COMMAND powershell -NoProfile -ExecutionPolicy Bypass -File "${CMAKE_CURRENT_LIST_DIR}/compress_file.ps1" "${IN_FILE}" "${TEMP_GZ}"
        RESULT_VARIABLE GZ_RES
    )
    if(GZ_RES EQUAL 0 AND EXISTS "${TEMP_GZ}")
        set(READ_TARGET "${TEMP_GZ}")
        set(CLEANUP_TEMP ON)
    else()
        message(WARNING "Compression failed (${GZ_RES}), falling back to uncompressed binary")
    endif()
endif()

file(READ "${READ_TARGET}" HEX_DATA HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," C_ARRAY "${HEX_DATA}")
string(REGEX REPLACE "(0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],0x[0-9a-f][0-9a-f],)" "\\1\n" WRAPPED "${C_ARRAY}")

file(WRITE "${OUT_FILE}" "// Auto-generated by embed_file.cmake. Do not edit manually.\n#pragma once\n#include <cstddef>\n\ninline constexpr unsigned char ${VAR_NAME}[] = {\n${WRAPPED}\n};\ninline constexpr size_t ${VAR_NAME}Size = sizeof(${VAR_NAME});\n")

if(CLEANUP_TEMP AND EXISTS "${TEMP_GZ}")
    file(REMOVE "${TEMP_GZ}")
endif()
