#include <winres.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "SteamDaddy"
            VALUE "FileDescription",  "SteamDaddy Core Engine"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "SteamDaddy.dll"
            VALUE "LegalCopyright (C) 2024-2026 SteamDaddy"
            VALUE "OriginalFilename", "SteamDaddy.dll"
            VALUE "ProductName",      "SteamDaddy"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
